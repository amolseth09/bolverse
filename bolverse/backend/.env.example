# Leave empty to disable auth on a private network. Set a long random string when exposed.
BOLVERSE_API_KEY=
# Comma-separated origins allowed to call the API from a browser.
BOLVERSE_CORS_ORIGINS=http://localhost:5173
# auto | cuda | mps | cpu
BOLVERSE_DEVICE=auto

# Speech to text
BOLVERSE_ASR_MODEL=openai/whisper-large-v3-turbo
# AI4Bharat IndicConformer for Indian languages (falls back to Whisper if it can't load)
BOLVERSE_INDIC_ASR=true
# Reduce background noise and trim silence before recognition
BOLVERSE_DENOISE=true
# Translation: nllb (fast, dedicated) or llm (uses BOLVERSE_LLM_MODEL, license-friendly)
BOLVERSE_TRANSLATION_BACKEND=nllb
BOLVERSE_NLLB_MODEL=facebook/nllb-200-distilled-600M
# Lessons and tutor answers
BOLVERSE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
BOLVERSE_LLM_4BIT=false
# Server voices (facebook/mms-tts-*). Clients fall back to the device voice when off or missing.
BOLVERSE_TTS_ENABLED=true
# Voice worker for male and female voices (docker compose sets this). Empty = off.
BOLVERSE_VOICE_WORKER_URL=http://127.0.0.1:8001
BOLVERSE_TTS_CACHE_SIZE=4

# Where generated lessons are cached
BOLVERSE_DATA_DIR=./data
# Load ASR, translation and LLM at startup instead of on first request
BOLVERSE_PRELOAD=false

# ================= Where the AI runs =================
# Empty: in this server (Colab, one GPU machine). For the cheap split deployment set the AI worker's URL,
# e.g. https://YOUR_ENDPOINT_ID.api.runpod.ai, with the RunPod API key and a shared secret.
BOLVERSE_AI_URL=
BOLVERSE_AI_AUTH=
BOLVERSE_AI_SECRET=
# Production domain for docker-compose.api.yml (HTTPS via Caddy)
BOLVERSE_DOMAIN=
# Web app address, served by the same server (e.g. app.yourdomain.com)
BOLVERSE_APP_DOMAIN=

# ================= Features =================
BOLVERSE_LEARNING_ENABLED=false

# ================= Accounts, limits and billing =================
# false = open mode: no login, no limits, no paywall. Everything below is ignored.
BOLVERSE_ACCOUNTS_ENABLED=true
# Long random string (e.g. `openssl rand -hex 32`). Signs sessions, codes and payment links.
BOLVERSE_SECRET_KEY=
# PostgreSQL in production (docker compose sets this for you). SQLite file when unset.
# BOLVERSE_DATABASE_URL=postgresql+psycopg://bolverse:password@localhost:5432/bolverse
# Password for the bundled Postgres container
POSTGRES_PASSWORD=change-me
# Public address of this server, used in payment links and return pages
BOLVERSE_PUBLIC_BASE_URL=http://localhost:8000
# development | production. Test accounts (code 123456), codes shown in the app and simulated payments
# exist only in development. Production also requires HTTPS, a real SMS provider and the keys below.
APP_ENV=development
# Signing key for tokens and links. Generate: python -c "import secrets;print(secrets.token_hex(32))"
BOLVERSE_SECRET_KEY=
# Encryption key for data at rest (phone, name, date of birth, Connect messages). Generate:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Keep a copy OUTSIDE your database backups: without it encrypted data can't be read.
BOLVERSE_DATA_KEY=
# After rotating BOLVERSE_DATA_KEY, put the previous key(s) here (comma-separated), then run
# python -m app.manage reindex-phones
BOLVERSE_DATA_KEYS_OLD=
# Access tokens last this many minutes; refresh tokens (rotating) last BOLVERSE_SESSION_DAYS.
BOLVERSE_ACCESS_TOKEN_MINUTES=15
BOLVERSE_SESSION_DAYS=90
# Long-lived tokens from apps older than 1.2: allowed in development, refused in production by default.
# BOLVERSE_ALLOW_LEGACY_SESSIONS=false
# Refuse plain HTTP (always on when APP_ENV=production)
# BOLVERSE_REQUIRE_HTTPS=true
BOLVERSE_MIN_AGE=13

# Free translations in total, for guests (no login) and free accounts; then the paywall. Premium is unlimited.
BOLVERSE_FREE_TRANSLATIONS=50
# 0 = the total above. A number gives signed-in free users that many per day instead (resets at midnight).
BOLVERSE_FREE_TRANSLATIONS_PER_DAY=0
BOLVERSE_TIMEZONE=Asia/Kolkata
# Create the test accounts (code 123456). Only ever active while APP_ENV=development.
BOLVERSE_SEED_TEST_USERS=true

# SMS codes: console (development only, prints the code) | android (free: your own phone + SIM) |
# msg91 (India, needs DLT) | twilio_verify | twilio. See docs/sms-gateway-setup.md.
BOLVERSE_SMS_PROVIDER=console
BOLVERSE_OTP_TTL_SECONDS=300
BOLVERSE_OTP_RESEND_SECONDS=30
BOLVERSE_OTP_DAILY_LIMIT=10
# Per network (IP); generous because mobile networks share IPs (CGNAT)
BOLVERSE_OTP_IP_PER_MINUTE=10
BOLVERSE_OTP_IP_DAILY=200
BOLVERSE_VERIFY_IP_PER_10MIN=50
# "SMS Gateway for Android" app (sms-gate.app), Cloud server mode: username/password from the app's Cloud server screen
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=

# Prices in paise (INR, Indian numbers) and cents (USD, everyone else)
# A price of 0 hides that pass. Default: week and month only.
BOLVERSE_PRICE_INR_DAY=0
BOLVERSE_PRICE_INR_WEEK=5000
BOLVERSE_PRICE_INR_MONTH=10000
BOLVERSE_PRICE_USD_DAY=0
BOLVERSE_PRICE_USD_WEEK=199
BOLVERSE_PRICE_USD_MONTH=399

# Direct UPI (no gateway fee): your business UPI ID. Customers pay by QR or UPI app and enter the
# 12-digit transaction ID; you approve it in the dashboard. Empty = off.
BOLVERSE_UPI_ID=
BOLVERSE_UPI_PAYEE_NAME=Bolverse
# Cards and international: cashfree | razorpay | dev (simulated; only works in development)
BOLVERSE_PAYMENT_PROVIDER_INR=dev
BOLVERSE_PAYMENT_PROVIDER_USD=dev
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox while testing, production when live
CASHFREE_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ================= Connect (QR chat) and notifications =================
BOLVERSE_INVITE_MINUTES=10
# Undelivered chat messages are deleted after this many hours (delivered ones are deleted at once)
BOLVERSE_MESSAGE_KEEP_HOURS=24
# Firebase service-account JSON (inside the container: /srv/secrets/firebase.json). Empty = no push when the app is closed.
BOLVERSE_FCM_SERVICE_ACCOUNT=

# ================= Admin dashboard (https://api.yourdomain.com/dashboard) =================
# Creates the first owner on startup if no dashboard users exist yet. Remove the password afterwards.
BOLVERSE_ADMIN_EMAIL=
BOLVERSE_ADMIN_PASSWORD=
BOLVERSE_ADMIN_SESSION_HOURS=12
BOLVERSE_DASHBOARD_DIR=./static/dashboard

# true = no AI models; placeholder translations (try logins, payments, chat and dashboard on any laptop)
BOLVERSE_AI_DEMO=false

# Connect: delivered messages are kept this long for your other devices; undelivered ones wait longer
BOLVERSE_MESSAGE_KEEP_HOURS=24
BOLVERSE_UNDELIVERED_KEEP_DAYS=7

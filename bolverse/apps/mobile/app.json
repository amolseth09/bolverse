{
  "expo": {
    "name": "Bolverse",
    "slug": "bolverse",
    "scheme": "bolverse",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.bolverse.translate",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bolverse listens when you tap the mic so it can translate what you say.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Bolverse uses the camera to scan another person's QR code so you can chat."
      }
    },
    "android": {
      "package": "app.bolverse.translate",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#3D4FE0"
      },
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Bolverse listens when you tap the mic so it can translate what you say."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6FF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0B0920"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bolverse uses the camera to scan another person's QR code so you can chat.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B45FF",
          "defaultChannel": "messages"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
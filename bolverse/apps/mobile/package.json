    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.8",
    "expo-localization": "~17.0.7",
    "expo-notifications": "~0.32.17",
